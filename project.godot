; Engine configuration file.
; Backrooms-OSS - an open source, procedurally generated Backrooms game.

config_version=5

[application]

config/name="Backrooms-OSS"
config/description="Open source infinite Backrooms exploration game."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/autoload/settings.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/vsync/vsync_mode=1
window/frame_pacing/android/enable_frame_pacing=true
window/frame_pacing/android/swappy_mode=2

[debug]

file_logging/enable_file_logging.diag=true
file_logging/max_log_files=2

[input_devices]

pointing/emulate_mouse_from_touch=true
pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]


renderer/rendering_method="mobile"
renderer/rendering_method.ultra="forward_plus"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
anti_aliasing/quality/msaa_3d=1
anti_aliasing/quality/msaa_3d.ultra=0
anti_aliasing/quality/screen_space_aa.ultra=2
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
textures/default_filters/anisotropic_filtering_level=2
environment/volumetric_fog/volume_size.mobile=48
environment/volumetric_fog/volume_depth.mobile=48
environment/ssao/quality.mobile=1
environment/ssil/quality.mobile=1

[shader_globals]

ps1_grid={
"type": "vec2",
"value": Vector2(0, 0)
}
world_time={
"type": "float",
"value": 0.0
}
dark_lift={
"type": "float",
"value": 0.0
}
photoreal={
"type": "float",
"value": 0.0
}
flash_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
flash_dir={
"type": "vec3",
"value": Vector3(0, 0, -1)
}
flash_params={
"type": "vec4",
"value": Vector4(0, 24, 0.88, 0.95)
}
lining_pos={
"type": "vec4",
"value": Vector4(0, 0, 0, 0)
}
lining_right={
"type": "vec4",
"value": Vector4(1, 0, 0, 0)
}
lining_normal={
"type": "vec4",
"value": Vector4(0, 0, 1, 0)
}
lining_tex={
"type": "sampler2D",
"value": ""
}
level_light_0={
"type": "vec4",
"value": Vector4(1, 1, 1, 1)
}
level_light_1={
"type": "vec4",
"value": Vector4(1, 1, 1, 1)
}
level_light_2={
"type": "vec4",
"value": Vector4(1, 1, 1, 1)
}
level_light_3={
"type": "vec4",
"value": Vector4(1, 1, 1, 1)
}

[editor_plugins]

enabled=PackedStringArray("res://addons/android_game_mode/plugin.cfg")
